# ---------------------------------------------------------------
# Pehchan - environment variables
#   Development : copy this file to .env
#   Hostinger   : hPanel -> your Node.js app -> Environment variables
# ---------------------------------------------------------------
DEBUG=False
# Recommended. If empty in production, a permanent key is generated on the
# first start and stored in the database (table app_settings).
SECRET_KEY=change-me-to-a-long-random-string
# Hostinger sets PORT automatically
PORT=8000

# MySQL (Hostinger: host 127.0.0.1, port 3306, database/user from hPanel -> Databases)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u000000000_pehchan
DB_USER=u000000000_pehchan
DB_PASSWORD=
# On every start/deploy: create only the tables that do not exist yet (never drops data)
DB_AUTO_SYNC=True
# Set to True for ONE deploy after an update that adds new columns, then back to False
DB_SYNC_ALTER=False

# First deploy: the superuser is created automatically when the database has none.
# Later deploys never change it. If ADMIN_PASSWORD is empty, a one-time password
# is generated and printed in the app log - change it after the first login.
AUTO_CREATE_ADMIN=True
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pehchanyui.in
ADMIN_PASSWORD=

# Uploaded files. Default in production: ~/pehchan_media (outside the app folder,
# so redeploys keep them). Example: /home/u000000000/pehchan_media
MEDIA_ROOT=

# Email (SMTP) - OTP mails, certificate mails, contact replies
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# UPI id shown on the money donation page
DONATION_UPI_ID=anikshaupadhyay2001@okicici

# Cookies / HTTPS
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
