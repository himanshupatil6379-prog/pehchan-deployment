{
  "name": "pehchanyui",
  "version": "1.0.0",
  "private": true,
  "description": "Pehchan - Empowering Communities. MERN-stack (MySQL) port of the Pehchan Django web application.",
  "type": "module",
  "main": "backend/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch-path=backend backend/index.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/index.js",
    "setup": "node backend/scripts/setup.js",
    "db:sync": "node backend/scripts/db-sync.js",
    "create-admin": "node backend/scripts/create-admin-user.js",
    "populate": "node backend/scripts/populate-db.js",
    "import:django": "node backend/scripts/import-django-dump.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "sequelize": "^6.37.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
